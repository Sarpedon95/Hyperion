<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- CarPlay Audio entitlement.
	     Also requires the CarPlay capability to be added in Xcode →
	     Signing & Capabilities → + Capability → CarPlay → Audio App.
	     Without the provisioning profile including this entitlement,
	     CarPlaySceneDelegate will never be instantiated at runtime. -->
	<key>com.apple.developer.carplay-audio</key>
	<true/>
	<!-- App Group shared with the HyperionWidget extension so the widget
	     can read the current track without an IPC call. Must also be
	     registered in the Apple Developer portal and provisioning profile. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.sarpedon.hyperion</string>
	</array>
</dict>
</plist>
