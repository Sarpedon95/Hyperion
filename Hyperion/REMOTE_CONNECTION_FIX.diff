+    private enum URLConnectionKind: Equatable {
+        case local
+        case tailscale
+        case remote
+
+        var displayName: String {
+            switch self {
+            case .local:     return "Home"
+            case .tailscale: return "Tailscale"
+            case .remote:    return "Remote"
+            }
+        }
+    }
+
+    private nonisolated static func connectionKind(for rawURL: String) -> URLConnectionKind {
+        let sanitized = sanitizedURL(rawURL)
+        guard let components = URLComponents(string: sanitized),
+              let host = components.host?.lowercased(),
+              !host.isEmpty else {
+            return .remote
+        }
+
+        if host == "localhost" || host == "127.0.0.1" || host.hasSuffix(".local") {
+            return .local
+        }
+
+        let octets = host.split(separator: ".").compactMap { Int($0) }
+        if octets.count == 4 {
+            let a = octets[0]
+            let b = octets[1]
+            if a == 10 || a == 127 || (a == 172 && (16...31).contains(b)) || (a == 192 && b == 168) {
+                return .local
+            }
+            if a == 100 && (64...127).contains(b) {
+                return .tailscale
+            }
+            return .remote
+        }
+
+        if sanitized.lowercased().hasPrefix("https://") {
+            return .remote
+        }
+        return .remote
+    }
+
     private func displayURL(_ url: String) -> String {
         let sanitized = Self.sanitizedURL(url)
         return sanitized.isEmpty ? "not set" : ServerLogStore.redactedURL(sanitized)
