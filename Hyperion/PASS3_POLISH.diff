+    /// Pre-normalized search query.  Search calls compare hundreds of strings
+    /// per keystroke, so normalize/tokenize the query once instead of doing it
+    /// repeatedly for every composer, work, and album candidate.
+    private struct SearchNeedle {
+        let folded: String
+        let tokens: [String]
+
+        init(_ raw: String) {
+            self.folded = Self.fold(raw)
+            self.tokens = raw
+                .split(whereSeparator: \.isWhitespace)
+                .map { Self.fold(String($0)) }
+        }
+
+        func matches(_ text: String) -> Bool {
+            let foldedText = Self.fold(text)
+            if foldedText.contains(folded) { return true }
+
+            // Token path: require every token to appear in the target text.
+            // This handles multi-word queries typed in any order and also
+            // handles a token matching from the middle of a title.
+            guard tokens.count > 1 else { return false }
+            return tokens.allSatisfy { foldedText.contains($0) }
+        }
+
+        static func fold(_ value: String) -> String {
+            value
+                .folding(options: [.caseInsensitive, .diacriticInsensitive], locale: .current)
+                .lowercased()
+        }
+    }
+
+    private static func matches(text: String, needle: SearchNeedle) -> Bool {
+        needle.matches(text)
