// Hyperion API secrets — copy to Secrets.xcconfig (gitignored) and fill in real values.
// In Xcode: Project → Info → Configurations, set each config to use Secrets.xcconfig.
// Reference values in Info.plist as $(LASTFM_API_KEY) etc.

LASTFM_API_KEY = your_lastfm_api_key_here
LASTFM_SHARED_SECRET = your_lastfm_shared_secret_here
DISCOGS_CONSUMER_KEY = your_discogs_consumer_key_here
DISCOGS_CONSUMER_SECRET = your_discogs_consumer_secret_here
